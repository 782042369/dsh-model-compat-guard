{
  "name": "dsh-model-compat-guard",
  "version": "0.4.0",
  "description": "DSH compatibility guard: repairs compaction limits, fail-safe sandbox escalation, and missing tool descriptions for third-party models; capability lookups are cached and the deprecated prompt-injection path is off by default.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --check src/index.js && HOME=$(mktemp -d) node test/smoke.mjs",
    "check": "npm test && git diff --check"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "compatibility",
    "compaction",
    "reasoning-models",
    "gpt",
    "qwen",
    "ptc",
    "code-mode",
    "run-code"
  ],
  "author": "782042369",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/782042369/dsh-model-compat-guard.git"
  },
  "bugs": {
    "url": "https://github.com/782042369/dsh-model-compat-guard/issues"
  },
  "homepage": "https://github.com/782042369/dsh-model-compat-guard#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}